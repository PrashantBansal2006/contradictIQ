# ── Environment ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/app.db
JWT_SECRET=change-me-before-production

# ── LLM ─────────────────────────────────────────────────────────────────────
# Set to "none" to disable LLM (rule-based only); safe default for offline demo.
LLM_PROVIDER=none
# LLM_PROVIDER=gemini | groq | openai | ollama | anthropic
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# ── Upload limits ────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=20

# ── Fiscal year ──────────────────────────────────────────────────────────────
# 3 = March (India default). Change to 12 for calendar-year companies.
FY_END_MONTH=3

# ── Verification ────────────────────────────────────────────────────────────
MIN_CONFIDENCE=0.8

# ── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
